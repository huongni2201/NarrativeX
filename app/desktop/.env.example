# NarrativeX Electron Desktop local development.
# Copy to app/desktop/.env before running `npm run dev`.

# Backend exposed by the root docker-compose.yml local stack.
VITE_API_BASE_URL=http://localhost:8080

# Local project rendering / device execution.
VITE_DESKTOP_PROJECT_RENDER_ENABLED=true
VITE_DESKTOP_HEARTBEAT_MS=15000

# Optional runtime overrides for Electron main. These override VITE_* values
# when they are present in the process environment.
# NARRATIVEX_BACKEND_URL=http://localhost:8080
# NARRATIVEX_DESKTOP_PROJECT_RENDER_ENABLED=true
# NARRATIVEX_DESKTOP_HEARTBEAT_MS=15000

# Optional explicit FFmpeg paths on Windows. Leave unset when ffmpeg/ffprobe are on PATH.
# NARRATIVEX_FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# NARRATIVEX_FFPROBE_PATH=C:\\ffmpeg\\bin\\ffprobe.exe

# Desktop OAuth flow:
#   http://localhost:8080/api/v1/auth/desktop/start
#   -> Google OAuth
#   -> http://localhost:8080/login/oauth2/code/google
#   -> narrativex://auth/callback
