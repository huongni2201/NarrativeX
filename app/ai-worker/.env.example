# Worker Environment Configuration
WORKER_NAME=narrativex-worker
WORKER_ENV=development
# Host only the roles this process should execute. Final video rendering runs in Electron Desktop.
WORKER_ROLES=analysis,narration,media-validation,image-generation
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8080
HEALTH_CHECK_PORT=8001
DATABASE_URL=postgresql://narrativex:change-me@localhost:5432/narrativex
POLL_INTERVAL_SECONDS=1
LEASE_SECONDS=60
WORKER_CONCURRENCY=4
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=104857600
MEDIA_MAX_VIDEO_BYTES=1073741824

AI_PROVIDER_MODE=disabled
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_SECONDS=120
GOOGLE_APPLICATION_CREDENTIALS=/home/appuser/.config/gcloud/application_default_credentials.json

TTS_PROVIDER_MODE=disabled
TTS_PRICING_CATALOG_VERSION=vieneu-local-2026-08-23
NARRATION_MP3_BITRATE=96k
# Ngọc Huyền v2 remains the default custom-enrolled voice.
VIENEU_VOICE_ID=vieneu-ngoc-huyen-v2
VIENEU_VOICE_NAME=Ngọc Huyền v2
VIENEU_REFERENCE_AUDIO_PATH=/run/narrativex/voices/ngoc_huyen_sample.wav
VIENEU_BACKEND=auto
VIENEU_PRECISION=int8
VIENEU_THREADS=0
VIENEU_BATCH_MAX_SEGMENTS=8
VIENEU_MAX_BATCH_SIZE=32
VIENEU_INFERENCE_CONCURRENCY=1
VIENEU_DENOISE_REFERENCE=true
VIENEU_SAVE_VOICE_PROFILE=false
VIENEU_FORCE_REENROLL=false
VIENEU_APPLY_WATERMARK=false
MEDIA_STORAGE_MODE=disabled
MEDIA_LOCAL_DIR=/tmp/narrativex-e2e/media

# Gemini 2.5 Flash Image on Vertex AI. GCS is provider staging only; generated media is
# stored in R2 until Desktop materializes it into the local project workspace.
IMAGE_PROVIDER_MODE=disabled
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_IMAGE_LOCATION=global
VERTEX_IMAGE_TIMEOUT_SECONDS=120
VERTEX_IMAGE_SERVICE_TIER=standard
VERTEX_IMAGE_BATCH_MAX_ITEMS=50
VERTEX_IMAGE_BATCH_LOCATION=global
VERTEX_IMAGE_BATCH_GCS_BUCKET=
VERTEX_IMAGE_BATCH_GCS_PREFIX=narrativex/image-batches
VERTEX_IMAGE_BATCH_POLL_SECONDS=30
VERTEX_IMAGE_BATCH_HTTP_TIMEOUT_SECONDS=120
VERTEX_IMAGE_UNKNOWN_MAX_AGE_SECONDS=3600
IMAGE_MAX_OUTPUT_BYTES=10485760

WAN_VIDEO_ENABLED=false
WAN_ENDPOINT_URL=
WAN_MODEL=Wan2.2-TI2V-5B
WAN_API_TOKEN=
WAN_REQUEST_TIMEOUT_SECONDS=30

# Cloudflare R2 durable transport for generated provider media.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-dev
R2_ENDPOINT=
