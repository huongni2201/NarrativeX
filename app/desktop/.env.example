VITE_API_BASE_URL=http://localhost:8080
VITE_DESKTOP_PROJECT_RENDER_ENABLED=true
VITE_DESKTOP_HEARTBEAT_MS=15000

# Optional Chrome override for Gemini Web automation.
# NARRATIVEX_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Gemini Web parallel-tab defaults. Values must be integers from 1 to 8.
# Per-user values changed in Settings override these defaults; Reset Gemini settings
# removes the user override and falls back to these values again.
NARRATIVEX_GEMINI_CHARACTER_TAB_COUNT=2
NARRATIVEX_GEMINI_STORYBOARD_TAB_COUNT=4
