{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/compute/v1/task-video-generate.json",
  "title": "VideoGenerateInputs",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "negativePrompt", "width", "height", "fps", "durationMs", "generationMode", "seed"],
  "properties": {
    "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
    "negativePrompt": {"type": "string", "maxLength": 10000},
    "width": {"type": "integer", "minimum": 64, "maximum": 8192},
    "height": {"type": "integer", "minimum": 64, "maximum": 8192},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "durationMs": {"type": "integer", "minimum": 100, "maximum": 60000},
    "generationMode": {
      "type": "string",
      "enum": [
        "TEXT_TO_VIDEO",
        "IMAGE_TO_VIDEO",
        "FIRST_LAST_FRAME",
        "MULTI_KEYFRAME",
        "VIDEO_EXTEND",
        "VIDEO_RETAKE"
      ]
    },
    "seed": {"type": "integer", "minimum": 0},
    "motionBucketId": {"type": "integer", "minimum": 1, "maximum": 255},
    "referenceAssetIds": {
      "type": "array",
      "items": {"type": "string", "format": "uuid"}
    }
  }
}
