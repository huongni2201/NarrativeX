# Worker Environment Configuration
WORKER_NAME=narrativex-worker
WORKER_ENV=development
LOG_LEVEL=INFO
BACKEND_URL=http://localhost:8080
HEALTH_CHECK_PORT=8001
DATABASE_URL=postgresql://narrativex:change-me@localhost:5432/narrativex
POLL_INTERVAL_SECONDS=1
LEASE_SECONDS=60
WORKER_CONCURRENCY=4

# Story-analysis provider configuration; credentials come from ADC/workload identity.
AI_PROVIDER_MODE=disabled
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_SECONDS=120
# In Docker this path is backed by the read-only host gcloud mount in docker-compose.yml.
GOOGLE_APPLICATION_CREDENTIALS=/home/appuser/.config/gcloud/application_default_credentials.json

# Full-chapter narration. Google TTS uses ADC; durable audio is stored in Cloudflare R2.
TTS_PROVIDER_MODE=disabled
GOOGLE_TTS_PROJECT_ID=
GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com
GOOGLE_TTS_TIMEOUT_SECONDS=120
TTS_PRICING_CATALOG_VERSION=google-tts-2026-08-20
# VieNeu-TTS v3 Turbo / Instant Voice Cloning. The sample stays outside git.
VIENEU_VOICE_ID=vieneu-ngoc-huyen-v2
VIENEU_VOICE_NAME=Ngọc Huyền v2
VIENEU_REFERENCE_AUDIO_PATH=
VIENEU_BACKEND=auto
VIENEU_PRECISION=int8
VIENEU_THREADS=0
VIENEU_DENOISE_REFERENCE=true
VIENEU_SAVE_VOICE_PROFILE=true
VIENEU_FORCE_REENROLL=false
VIENEU_APPLY_WATERMARK=false
MEDIA_STORAGE_MODE=disabled

# MVP image generation; credentials come from ADC/workload identity.
IMAGE_PROVIDER_MODE=disabled
VERTEX_IMAGE_MODEL=imagen-3.0-generate-002
VERTEX_IMAGE_LOCATION=us-central1
VERTEX_IMAGE_TIMEOUT_SECONDS=120
IMAGE_MAX_OUTPUT_BYTES=10485760

# Cloudflare R2 durable media storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-dev
R2_ENDPOINT=
