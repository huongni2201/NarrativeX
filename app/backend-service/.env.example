# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=narrativex

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Security & CORS Configuration
NARRATIVEX_OIDC_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_FRONTEND_BASE_URL=http://localhost:3000
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vertex/Gemini provider configuration; credentials come from ADC/workload identity.
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
