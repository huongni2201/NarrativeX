VITE_API_BASE_URL=http://localhost:8080
VITE_DESKTOP_PROJECT_RENDER_ENABLED=true
VITE_DESKTOP_HEARTBEAT_MS=15000

# Optional path override when agy is not discoverable through PATH or its default install folders.
NARRATIVEX_AGY_PATH=

# Set to 1 only after scripts/agy-cli-spike.ps1 (step 6b) shows agy cannot read files outside its scratch folder.
# Until then NarrativeX will not send chapter text to agy.
NARRATIVEX_AGY_ISOLATION_VERIFIED=
