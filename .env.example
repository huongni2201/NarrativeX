# Local Docker Compose configuration.
# Copy this file to .env before starting the stack. Never commit the copied file.

# PostgreSQL Database Configuration
DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=change-me-local-only

# Redis Configuration
REDIS_PORT=6379
NARRATIVEX_SESSION_TIMEOUT=7d
NARRATIVEX_SESSION_REDIS_NAMESPACE=narrativex:session

# Backend Service Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Security, Identity & Policy Configuration
# Real email/password login is standard. Set NARRATIVEX_LOCAL_DEV_IDENTITY_ENABLED=true only for testing fallback.
# The local Spring profile allows a non-Secure session cookie for http://localhost only; shared environments default to Secure=true.
NARRATIVEX_OIDC_ENABLED=false
NARRATIVEX_LOCAL_DEV_IDENTITY_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_FRONTEND_BASE_URL=http://localhost:3000
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google OAuth / OIDC Configuration (Set NARRATIVEX_OIDC_ENABLED=true when enabled)
# Authorized redirect URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Vertex AI / Gemini Configuration (Disabled by default; uses ADC/Workload Identity)
# VERTEX_GEMINI_ENABLED does not enable the AI worker.
# To make the worker call Vertex, set AI_PROVIDER_MODE=vertex.
AI_PROVIDER_MODE=disabled
WORKER_CONCURRENCY=4
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# MinIO Local Object Storage (S3-compatible)
S3_ACCESS_KEY=narrativex
S3_SECRET_KEY=change-me-local-only
S3_PORT=9000
MINIO_CONSOLE_PORT=9001

