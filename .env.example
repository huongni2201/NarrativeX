NARRATIVEX_PUBLIC_BASE_URL=http://localhost:8080

DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=replace-with-strong-password

NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m

# Domain-neutral compute execution plane. The generation service receives protocol tasks only;
# it never receives DATABASE_URL, R2 credentials, project-relative paths, or business IDs.
GENERATION_SERVICE_MACHINE_TOKEN=replace-with-a-long-random-key
GENERATION_MAX_CONCURRENCY=1
GENERATION_SERVICE_QWEN_BASE_URL=http://host.docker.internal:8000/v1
GENERATION_SERVICE_QWEN_API_KEY=
GENERATION_SERVICE_QWEN_TIMEOUT_SECONDS=600
GENERATION_SERVICE_COMFYUI_BASE_URL=http://host.docker.internal:8188
GENERATION_SERVICE_COMFYUI_TIMEOUT_SECONDS=120
GENERATION_SERVICE_VOICESTUDIO_BASE_URL=http://voicestudio:3900
GENERATION_SERVICE_VOICESTUDIO_API_KEY=replace-with-a-long-random-key
GENERATION_SERVICE_VOICESTUDIO_TIMEOUT_SECONDS=600
GENERATION_SERVICE_WHISPERX_DEVICE=cuda
GENERATION_SERVICE_WHISPERX_ALIGN_MODEL_NAME=

# Host directory shared by Docker workers for generated project media.
# Windows example: D:/NarrativeXData/project-media
PROJECT_MEDIA_HOST_DIR=/absolute/path/to/narrativex/project-media

NARRATIVEX_IMAGE_PROVIDER_KEY=realvisxl
NARRATIVEX_IMAGE_MODEL=realvisxl
NARRATIVEX_IMAGE_EXECUTION_MODE=batch

# VoiceStudio 0.5.x is the only TTS backend. NarrativeX calls its headless API and the global GPU
# ownership layer unloads the resident engine before another heavy model takes the RTX 4060.
VOICESTUDIO_IMAGE=ghcr.io/debpalash/omnivoice-studio:0.5.2

# Backend-issued capability URLs are used for all provider input/output artifacts.
NARRATIVEX_COMPUTE_ARTIFACT_BASE_URL=http://localhost:8080
NARRATIVEX_COMPUTE_ARTIFACT_TTL=15m
NARRATIVEX_MAX_COMPUTE_ARTIFACT_BYTES=268435456
