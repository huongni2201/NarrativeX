# Internal Backend URL for Next.js API Proxy / Rewrites
BACKEND_INTERNAL_URL=http://localhost:8080

# Client-side API Base URL (leave empty or unset for same-origin API proxy via Next.js)
NEXT_PUBLIC_API_BASE_URL=

# Browser-visible backend origin used for OAuth navigation. OAuth must start directly on
# Spring Boot so Google receives the backend callback URI, not the Next.js origin.
NEXT_PUBLIC_AUTH_BASE_URL=http://localhost:8080

# API is the default for every application runtime. Set mock only for tests or Storybook.
NEXT_PUBLIC_NX_DATA_MODE=api
