{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/compute/v1/compute-error.json",
  "title": "ComputeError",
  "type": "object",
  "additionalProperties": false,
  "required": ["code", "category", "message", "retryAfterSeconds", "details"],
  "properties": {
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$"},
    "category": {"type": "string", "enum": ["PERMANENT", "TRANSIENT", "CAPACITY", "CANCELED"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 500},
    "retryAfterSeconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400},
    "details": {"type": "object", "maxProperties": 16, "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}}
  }
}
