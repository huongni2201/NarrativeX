{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/compute/v1/output-artifact-target.json",
  "title": "OutputArtifactTarget",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "role", "mediaType", "access"],
  "properties": {
    "artifactId": {"type": "string", "format": "uuid"},
    "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "mediaType": {"type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"},
    "access": {"$ref": "artifact-write-access.json"}
  }
}
