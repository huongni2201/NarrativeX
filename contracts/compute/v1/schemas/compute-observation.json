{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/compute/v1/compute-observation.json",
  "title": "ComputeObservation",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "taskId", "attemptId", "state", "sequence", "observedAt", "outputs", "metrics"],
  "properties": {
    "protocolVersion": {"const": "1.0"},
    "taskId": {"type": "string", "format": "uuid"},
    "attemptId": {"type": "string", "format": "uuid"},
    "state": {"type": "string", "enum": ["ACCEPTED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELED"]},
    "sequence": {"type": "integer", "minimum": 0},
    "observedAt": {"type": "string", "format": "date-time"},
    "executionHandle": {"type": ["string", "null"], "maxLength": 512},
    "progress": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "outputs": {"type": "array", "maxItems": 32, "items": {"$ref": "artifact-ref.json"}},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runtimeMs": {"type": "integer", "minimum": 0},
        "gpuTimeMs": {"type": "integer", "minimum": 0},
        "peakVramBytes": {"type": "integer", "minimum": 0}
      }
    },
    "error": {"$ref": "compute-error.json"}
  }
}
