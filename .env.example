# Local Docker Compose configuration.
# Copy this file to .env before starting the stack. Never commit the copied file.

DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=change-me-local-only

REDIS_PORT=6379
NARRATIVEX_SESSION_TIMEOUT=7d
NARRATIVEX_SESSION_REDIS_NAMESPACE=narrativex:session

BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_MEDIA_GENERATION_ENABLED=false
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m

NARRATIVEX_OIDC_ENABLED=false
NARRATIVEX_LOCAL_DEV_IDENTITY_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_FRONTEND_BASE_URL=http://localhost:3000
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

WORKER_NAME=narrativex-ai-worker
WORKER_ENV=development
WORKER_ROLES=analysis,translation,narration,media-validation,image-generation
WORKER_LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
WORKER_CONCURRENCY=4
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=104857600
MEDIA_MAX_VIDEO_BYTES=1073741824

AI_PROVIDER_MODE=disabled
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_SECONDS=120
GOOGLE_CLOUD_CONFIG_HOST=
GOOGLE_APPLICATION_CREDENTIALS=/home/appuser/.config/gcloud/application_default_credentials.json

TTS_PROVIDER_MODE=disabled
GOOGLE_TTS_PROJECT_ID=
GOOGLE_TTS_ENDPOINT=https://texttospeech.googleapis.com
GOOGLE_TTS_TIMEOUT_SECONDS=120
TTS_PRICING_CATALOG_VERSION=google-tts-2026-08-20
NARRATION_MP3_BITRATE=96k
VIENEU_VOICE_ID=vieneu-ngoc-huyen-v2
VIENEU_VOICE_NAME=Ngọc Huyền v2
VIENEU_REFERENCE_AUDIO_HOST_DIR=
VIENEU_REFERENCE_AUDIO_PATH=/run/narrativex/voices/ngoc_huyen_sample.wav
VIENEU_BACKEND=auto
VIENEU_PRECISION=int8
VIENEU_THREADS=0
VIENEU_BATCH_MAX_SEGMENTS=8
VIENEU_MAX_BATCH_SIZE=32
VIENEU_INFERENCE_CONCURRENCY=1
VIENEU_DENOISE_REFERENCE=true
VIENEU_SAVE_VOICE_PROFILE=false
VIENEU_FORCE_REENROLL=false
VIENEU_APPLY_WATERMARK=false

IMAGE_PROVIDER_MODE=disabled
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_IMAGE_LOCATION=global
VERTEX_IMAGE_TIMEOUT_SECONDS=120
VERTEX_IMAGE_SERVICE_TIER=standard
VERTEX_IMAGE_EXECUTION_MODE=batch
VERTEX_IMAGE_BATCH_MAX_ITEMS=50
VERTEX_IMAGE_BATCH_LOCATION=global
VERTEX_IMAGE_BATCH_GCS_BUCKET=
VERTEX_IMAGE_BATCH_GCS_PREFIX=narrativex/image-batches
VERTEX_IMAGE_BATCH_POLL_SECONDS=30
VERTEX_IMAGE_BATCH_HTTP_TIMEOUT_SECONDS=120
VERTEX_IMAGE_UNKNOWN_MAX_AGE_SECONDS=3600
IMAGE_MAX_OUTPUT_BYTES=15000000

MEDIA_STORAGE_MODE=disabled
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-dev
R2_ENDPOINT=
