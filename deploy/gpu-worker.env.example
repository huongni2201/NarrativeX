# NarrativeX GPU worker (app/generation-service) environment template.
# Same keys on Windows and Linux. Windows: start.ps1 loads <InstallDir>\.env.
# Linux: export them before starting the worker, e.g. `set -a; . ./.env; set +a`.
# Never commit a filled-in copy: it holds the machine token.

GENERATION_SERVICE_HOST=0.0.0.0
GENERATION_SERVICE_PORT=8010
GENERATION_SERVICE_MACHINE_TOKEN=change-me
GENERATION_SERVICE_MAX_CONCURRENCY=1

# Backend reachability from the GPU node (loopback does not reach a backend on another machine).
NARRATIVEX_BACKEND_CALLBACK_URL=http://<backend-host>:8080/internal/compute/events
NARRATIVEX_COMPUTE_CALLBACK_SECRET=change-me

# Runtimes. Windows paths may keep backslashes; quote paths that contain spaces.
GENERATION_SERVICE_COMFYUI_BASE_URL=http://127.0.0.1:8188
GENERATION_SERVICE_VIENEU_BASE_URL=http://127.0.0.1:8008
GENERATION_SERVICE_WHISPERX_DEVICE=cuda
# Windows: C:\NarrativeXRuntime\runtimes\ComfyUI   Linux: /opt/narrativex/runtimes/ComfyUI
GENERATION_SERVICE_LTX_RUNTIME_DIRECTORY=/opt/narrativex/runtimes/ComfyUI
# Quote the value on Linux when sourcing with sh.
# GENERATION_SERVICE_COMFYUI_COMMAND="python /opt/narrativex/runtimes/ComfyUI/main.py --port 8188"

# ---------------------------------------------------------------------------
# LTX video model profile
# ---------------------------------------------------------------------------
# A profile is a pinned manifest in
# app/generation-service/src/narrativex_gpu_worker/adapters/executors/ltx/workflows/.
# Blank selects the default. An unknown id stops the worker at startup (no silent fallback).
# The backend must request the same profile and model:
#   NARRATIVEX_VIDEO_DEFAULT_PROFILE / NARRATIVEX_VIDEO_DEFAULT_MODEL (backend application.yml).
GENERATION_SERVICE_LTX_PROFILE=

# GPU size. Leave unset to read it from nvidia-smi; set it when nvidia-smi is missing.
# A GPU smaller than the profile's minVramMb keeps LTX unready with an explicit reason;
# TTS, alignment, image and media validation still run.
#
# Profile ltx-2.5-22b-distilled-int8-native-av-v1 (minVramMb 30720):
#   RTX 5090 32GB  -> supported target (unmeasured until a real run is recorded)
#   RTX 4090 24GB  -> LTX unready; TTS/align/image only
#   RTX 3090 24GB  -> LTX unready; TTS/align/image only
# A 24GB LTX profile needs its own pinned manifest after a measured run, not a lower number here.
# GENERATION_SERVICE_GPU_VRAM_MB=32607

# Residency budget the worker reserves for LTX; defaults to the profile's vramBudgetMb.
# GENERATION_SERVICE_LTX_VRAM_BUDGET_MB=32768
