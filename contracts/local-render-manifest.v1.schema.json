{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.dev/contracts/local-render-manifest.v1.schema.json",
  "title": "NarrativeX Local Render Manifest v1",
  "type": "object",
  "required": ["version", "jobId", "renderFingerprint", "width", "height", "fps", "beats", "audio", "subtitles", "output"],
  "properties": {
    "version": { "const": 1 },
    "jobId": { "type": "string", "format": "uuid" },
    "renderFingerprint": { "type": "string", "minLength": 1 },
    "width": { "type": "integer", "minimum": 1 },
    "height": { "type": "integer", "minimum": 1 },
    "fps": { "type": "number", "exclusiveMinimum": 0 },
    "beats": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "audio": { "type": "object", "additionalProperties": true },
    "subtitles": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
    "effects": { "type": "object", "additionalProperties": true },
    "output": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false
}
