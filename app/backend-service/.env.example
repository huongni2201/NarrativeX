# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=narrativex

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
NARRATIVEX_SESSION_TIMEOUT=7d
NARRATIVEX_SESSION_REDIS_NAMESPACE=narrativex:session

# Security & CORS Configuration
# Real email/password login is enabled by default. Keep the developer identity fallback off
# unless you explicitly need old local/test behavior.
NARRATIVEX_OIDC_ENABLED=false
NARRATIVEX_LOCAL_DEV_IDENTITY_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_FRONTEND_BASE_URL=http://localhost:3000
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_MEDIA_GENERATION_ENABLED=false
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Login (OIDC)
# In Google Cloud Console add this authorized redirect URI for local development:
# http://localhost:8080/login/oauth2/code/google
# Then set NARRATIVEX_OIDC_ENABLED=true.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Vertex/Gemini provider configuration; credentials come from ADC/workload identity.
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2 durable media storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-dev
R2_ENDPOINT=
