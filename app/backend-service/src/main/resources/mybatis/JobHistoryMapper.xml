<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.narrativex.backend.feature.generation.infrastructure.persistence.mybatis.JobHistoryMapper">
    <resultMap id="jobHistoryRow" type="com.narrativex.backend.feature.generation.infrastructure.persistence.mybatis.JobHistoryRow">
        <id property="id" column="id" />
        <result property="jobId" column="job_id" />
        <result property="projectId" column="project_id" />
        <result property="projectName" column="project_name" />
        <result property="jobType" column="job_type" />
        <result property="status" column="status" />
        <result property="progress" column="progress" />
        <result property="currentStep" column="current_step" />
        <result property="errorCode" column="error_code" />
        <result property="createdAt" column="created_at" />
        <result property="completedAt" column="completed_at" />
    </resultMap>

    <select id="list" resultMap="jobHistoryRow">
        SELECT j.id,
               j.job_id,
               j.project_id,
               p.name AS project_name,
               j.job_type,
               j.status,
               j.progress,
               j.current_step,
               j.error_code,
               j.created_at,
               CASE WHEN j.status IN ('COMPLETED', 'FAILED', 'CANCELED') THEN j.updated_at END AS completed_at
          FROM generation_jobs j
          JOIN projects p ON p.id = j.project_id
         WHERE j.requested_by_user_id = #{userId}
        <if test="cursorUpdatedAt != null">
           AND (j.created_at &lt; #{cursorUpdatedAt}
                OR (j.created_at = #{cursorUpdatedAt} AND j.id &lt; #{cursorId}))
        </if>
         ORDER BY j.created_at DESC, j.id DESC
         LIMIT #{limit}
    </select>
</mapper>
