<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.narrativex.backend.feature.generation.infrastructure.persistence.mybatis.OperationPlanMapper">
    <resultMap id="operationPlanRow" type="com.narrativex.backend.feature.generation.infrastructure.persistence.mybatis.OperationPlanRow">
        <id property="id" column="id" />
        <result property="rowVersion" column="row_version" />
        <result property="projectId" column="project_id" />
        <result property="generationJobId" column="generation_job_id" />
        <result property="operationType" column="operation_type" />
    </resultMap>

    <sql id="columns">
        id, row_version, project_id, generation_job_id, operation_type
    </sql>

    <select id="insert"
            parameterType="com.narrativex.backend.feature.generation.infrastructure.persistence.mybatis.OperationPlanRow"
            resultType="java.util.UUID" affectData="true">
        INSERT INTO operation_plans
            (project_id, generation_job_id, operation_type)
        VALUES
            (#{projectId}, #{generationJobId}, #{operationType})
        RETURNING id
    </select>

    <update id="updateCas"
            parameterType="com.narrativex.backend.feature.generation.infrastructure.persistence.mybatis.OperationPlanRow">
        UPDATE operation_plans
           SET project_id = #{projectId},
               generation_job_id = #{generationJobId},
               operation_type = #{operationType},
               updated_at = CURRENT_TIMESTAMP,
               row_version = row_version + 1
         WHERE id = #{id}
           AND row_version = #{rowVersion}
    </update>

    <select id="findById" resultMap="operationPlanRow">
        SELECT <include refid="columns" />
          FROM operation_plans
         WHERE id = #{id}
    </select>
</mapper>
