{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/compute/v1/model-ref.json",
  "title": "ModelRef",
  "type": "object",
  "additionalProperties": false,
  "required": ["executor", "model", "revision"],
  "properties": {
    "executor": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128}
  }
}
