# NarrativeX backend local development environment.
# Spring Boot does not load dotenv files automatically. Use these values in your shell/IDE
# run configuration when running the backend on the host. Docker Compose reads the root .env.

# Server Configuration
PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database Configuration
# When the backend runs directly on the host, localhost is correct.
# docker-compose.yml overrides DB_HOST to postgres inside the container.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=narrativex

# Session Configuration
# Spring Session JDBC and desktop OAuth handoffs use the same PostgreSQL database.
NARRATIVEX_SESSION_TIMEOUT=7d

# Authentication / Desktop
# NarrativeX uses Google OAuth only. Do not enable the legacy local identity fallback.
NARRATIVEX_OIDC_ENABLED=true
NARRATIVEX_LOCAL_DEV_IDENTITY_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_PUBLIC_BASE_URL=http://localhost:8080

# Electron development uses the Vite origin. `null` is kept only for local renderer/dev cases;
# the production root .env template intentionally leaves browser origins empty.
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,null

# Google Login (OIDC)
# In Google Cloud Console, add this Authorized redirect URI for local development:
# http://localhost:8080/login/oauth2/code/google
# For production, set NARRATIVEX_PUBLIC_BASE_URL to the same public HTTPS origin
# and add https://<public-origin>/login/oauth2/code/google instead.
# The custom Electron deep link narrativex://auth/callback is NOT the Google redirect URI.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Import / generation limits
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_MEDIA_GENERATION_ENABLED=false
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m

# Backend-authoritative image generation and admission pricing profile.
NARRATIVEX_IMAGE_PROVIDER_KEY=vertex
NARRATIVEX_IMAGE_MODEL=gemini-2.5-flash-image
NARRATIVEX_IMAGE_PRICING_VERSION=gemini-2.5-flash-image-batch-2026-08-22
NARRATIVEX_IMAGE_EXECUTION_MODE=batch
NARRATIVEX_IMAGE_UNIT_COST_DRAFT=0.10
NARRATIVEX_IMAGE_UNIT_COST_STANDARD=0.25
NARRATIVEX_IMAGE_UNIT_COST_HIGH=0.40

# Vertex/Gemini provider configuration; credentials come from ADC/workload identity.
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Cloudflare R2 transports generated provider media until Desktop materializes it locally.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-dev
R2_ENDPOINT=
