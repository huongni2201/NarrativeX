NARRATIVEX_PUBLIC_BASE_URL=http://localhost:8080

# NarrativeX Desktop Gemini Web defaults. Each user can override these values from
# Desktop Settings without editing .env; Reset Gemini settings falls back to these values.
NARRATIVEX_GEMINI_CHARACTER_TAB_COUNT=2
NARRATIVEX_GEMINI_STORYBOARD_TAB_COUNT=4

DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=replace-with-strong-password

NARRATIVEX_OIDC_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m

WORKER_LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
GENERAL_WORKER_CONCURRENCY=4
# VieNeu is CPU-bound on the ONNX path. Keep one chapter/inference active and reserve
# four logical CPUs for the desktop/OS even when a native runtime oversubscribes threads.
NARRATION_WORKER_CONCURRENCY=1
NARRATION_WORKER_CPUS=8.0
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=104857600
MEDIA_MAX_VIDEO_BYTES=1073741824

# Host directory shared by Docker workers for generated project media.
# Point this at a durable local directory on the same machine as NarrativeX Desktop.
# Windows example: D:/NarrativeXData/project-media
PROJECT_MEDIA_HOST_DIR=/absolute/path/to/narrativex/project-media

GOOGLE_CLOUD_PROJECT=
# Must point to an existing service-account JSON file. Compose will not create it.
GCP_SERVICE_ACCOUNT_FILE=/absolute/path/to/gcp-service-account.json
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_SECONDS=120
# Chapter analysis first extracts structure, then generates bounded visual-beat shards.
# Three concurrent shards is the default balance between latency and Vertex quota pressure.
VERTEX_ANALYSIS_SHARD_CONCURRENCY=3
VERTEX_ANALYSIS_SHARD_TARGET_BEATS=12
VERTEX_ANALYSIS_SHARD_MAX_BEATS=20
VERTEX_ANALYSIS_REPAIR_ATTEMPTS=1

# Backend MediaPlan and pricing admission use this image profile. Worker execution
# consumes the matching Vertex model/batch settings below.
NARRATIVEX_IMAGE_PROVIDER_KEY=vertex
NARRATIVEX_IMAGE_MODEL=gemini-2.5-flash-image
NARRATIVEX_IMAGE_PRICING_VERSION=gemini-2.5-flash-image-batch-2026-08-22
NARRATIVEX_IMAGE_EXECUTION_MODE=batch
NARRATIVEX_IMAGE_UNIT_COST_DRAFT=0.10
NARRATIVEX_IMAGE_UNIT_COST_STANDARD=0.25
NARRATIVEX_IMAGE_UNIT_COST_HIGH=0.40
VERTEX_IMAGE_LOCATION=global
VERTEX_IMAGE_TIMEOUT_SECONDS=120
VERTEX_IMAGE_BATCH_MAX_ITEMS=50
VERTEX_IMAGE_BATCH_LOCATION=global
VERTEX_IMAGE_BATCH_GCS_BUCKET=
VERTEX_IMAGE_BATCH_GCS_PREFIX=narrativex/image-batches
VERTEX_IMAGE_BATCH_POLL_SECONDS=30
VERTEX_IMAGE_BATCH_HTTP_TIMEOUT_SECONDS=120
VERTEX_IMAGE_UNKNOWN_MAX_AGE_SECONDS=3600
IMAGE_RECONCILE_MAX_ATTEMPTS=5
IMAGE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
IMAGE_CIRCUIT_BREAKER_OPEN_SECONDS=120
IMAGE_MAX_OUTPUT_BYTES=15000000

NARRATION_MP3_BITRATE=96k
# Ngọc Huyền v2 is the production default. Its reference audio is resolved from R2
# through voice_catalog metadata rather than a required host-mounted WAV file.
VIENEU_VOICE_ID=vieneu-ngoc-huyen-v2
VIENEU_VOICE_NAME=Ngọc Huyền v2
# Use deterministic CPU/ONNX inference on desktop-class machines. A GPU render path can
# be configured independently later without moving narration to PyTorch/CUDA.
VIENEU_BACKEND=onnx
VIENEU_PRECISION=int8
VIENEU_THREADS=4
VIENEU_BATCH_MAX_SEGMENTS=8
VIENEU_MAX_BATCH_SIZE=32
VIENEU_INFERENCE_CONCURRENCY=1
# Bound native math runtimes so ONNX/NumPy dependencies cannot consume all logical CPUs.
VIENEU_OMP_NUM_THREADS=4
VIENEU_MKL_NUM_THREADS=4
VIENEU_OPENBLAS_NUM_THREADS=1
VIENEU_NUMEXPR_NUM_THREADS=1
VIENEU_DENOISE_REFERENCE=true
VIENEU_SAVE_VOICE_PROFILE=false
VIENEU_FORCE_REENROLL=false
VIENEU_APPLY_WATERMARK=false

# R2 stores system and account-owned voice-reference/custom-voice files.
# Generated narration, images, imported media, and render artifacts stay on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-prod