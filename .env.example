# Local Docker Compose configuration.
# Copy this file to .env before starting the stack. Never commit the copied file.

# PostgreSQL Database Configuration
DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=change-me-local-only

# Redis Configuration
REDIS_PORT=6379
NARRATIVEX_SESSION_TIMEOUT=7d
NARRATIVEX_SESSION_REDIS_NAMESPACE=narrativex:session

# Backend Service Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# Security, Identity & Policy Configuration
NARRATIVEX_OIDC_ENABLED=false
NARRATIVEX_LOCAL_DEV_IDENTITY_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_FRONTEND_BASE_URL=http://localhost:3000
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Story analysis
AI_PROVIDER_MODE=disabled
WORKER_CONCURRENCY=4
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# Full-chapter narration (disabled by default)
TTS_PROVIDER_MODE=disabled
GOOGLE_TTS_PROJECT_ID=
TTS_PRICING_CATALOG_VERSION=google-tts-2026-08-20
MEDIA_STORAGE_MODE=disabled

# Cloudflare R2 durable media storage.
# Set MEDIA_STORAGE_MODE=r2 before enabling TTS/media execution.
# Use a separate bucket/credential pair per environment.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-dev
R2_ENDPOINT=
