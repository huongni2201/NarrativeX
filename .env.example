NARRATIVEX_PUBLIC_BASE_URL=http://localhost:8080

# NarrativeX Desktop Gemini Web defaults. Each user can override these values from
# Desktop Settings without editing .env; Reset Gemini settings falls back to these values.
NARRATIVEX_GEMINI_CHARACTER_TAB_COUNT=2
NARRATIVEX_GEMINI_STORYBOARD_TAB_COUNT=4

DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=replace-with-strong-password

NARRATIVEX_OIDC_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m

WORKER_LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
# A single RTX 4060 must not execute Qwen and RealVisXL work concurrently inside this worker.
GENERAL_WORKER_CONCURRENCY=1
# Keep one narration Chapter active on an 8 GB GPU. VoiceStudio itself is a persistent
# service and reuses the selected engine across every segment in that Chapter.
NARRATION_WORKER_CONCURRENCY=1
NARRATION_WORKER_CPUS=4.0
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=104857600
MEDIA_MAX_VIDEO_BYTES=1073741824

# Host directory shared by Docker workers for generated project media.
# Point this at a durable local directory on the same machine as NarrativeX Desktop.
# Windows example: D:/NarrativeXData/project-media
PROJECT_MEDIA_HOST_DIR=/absolute/path/to/narrativex/project-media

# Chapter analysis uses a private local Qwen3 server. Start Qwen/Qwen3-8B-AWQ with
# an OpenAI-compatible runtime and schedule it separately from VoiceStudio on an 8 GB GPU.
QWEN_BASE_URL=http://host.docker.internal:8000/v1
QWEN_API_KEY=
QWEN_MODEL=Qwen/Qwen3-8B-AWQ
QWEN_TIMEOUT_SECONDS=600
QWEN_MAX_OUTPUT_TOKENS=16384
QWEN_ANALYSIS_SHARD_CONCURRENCY=1
QWEN_ANALYSIS_SHARD_TARGET_BEATS=12
QWEN_ANALYSIS_SHARD_MAX_BEATS=20
QWEN_ANALYSIS_REPAIR_ATTEMPTS=1

# Image generation is local through ComfyUI + RealVisXL. The model value is the exact
# checkpoint filename visible to CheckpointLoaderSimple in ComfyUI; do not use a marketing alias.
REALVISXL_BASE_URL=http://host.docker.internal:8188
REALVISXL_CHECKPOINT=replace-with-your-realvisxl-checkpoint.safetensors
REALVISXL_TIMEOUT_SECONDS=120
REALVISXL_STEPS=28
REALVISXL_CFG=5.5
REALVISXL_SAMPLER=dpmpp_2m_sde
REALVISXL_SCHEDULER=karras
REALVISXL_LORA_NAME=
REALVISXL_LORA_STRENGTH=0.65
# Optional in-container path to a ComfyUI API-format workflow that consumes uploaded immutable
# character references. Reference requests fail closed when this is not configured.
REALVISXL_REFERENCE_WORKFLOW_PATH=

# Backend MediaPlan admission and worker execution must share these exact values.
NARRATIVEX_IMAGE_PROVIDER_KEY=realvisxl
NARRATIVEX_IMAGE_MODEL=${REALVISXL_CHECKPOINT}
NARRATIVEX_IMAGE_EXECUTION_MODE=batch
IMAGE_BATCH_MAX_ITEMS=1
IMAGE_RECONCILE_MAX_ATTEMPTS=5
IMAGE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
IMAGE_CIRCUIT_BREAKER_OPEN_SECONDS=120
IMAGE_MAX_OUTPUT_BYTES=15000000

# VoiceStudio 0.5.x runs as a persistent headless API service. NarrativeX calls its
# OpenAI-compatible speech endpoint and stores 48 kHz mono WAV as the narration master.
VOICESTUDIO_IMAGE=ghcr.io/debpalash/omnivoice-studio:0.5.2
VOICESTUDIO_API_KEY=replace-with-a-long-random-key
VOICESTUDIO_MODEL=tts-1
VOICESTUDIO_VOICE_ID=voicestudio-default
VOICESTUDIO_VOICE_PROFILE_ID=default
VOICESTUDIO_TIMEOUT_SECONDS=600
VOICESTUDIO_INFERENCE_CONCURRENCY=1
TTS_SEGMENT_BATCH_SIZE=8

# R2 stores account-owned voice-reference/custom-voice files.
# Generated narration, images, imported media, and render artifacts stay on local disk.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-prod
