# Local Docker Compose configuration.
# Copy this file to .env before starting the stack. Never commit the copied file.

# PostgreSQL
DB_PORT=5432
DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=change-me-local-only

# Redis
REDIS_PORT=6379

# Backend host binding and runtime profile
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local

# NarrativeX local security and policy
NARRATIVEX_OIDC_ENABLED=false
NARRATIVEX_LOCAL_USER_ID=local-dev-user
NARRATIVEX_FRONTEND_BASE_URL=http://localhost:3000
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Vertex/Gemini is disabled by default. Use workload identity/ADC for credentials.
VERTEX_GEMINI_ENABLED=false
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash

# MinIO local credentials and host bindings
S3_ACCESS_KEY=narrativex
S3_SECRET_KEY=change-me-local-only
S3_PORT=9000
MINIO_CONSOLE_PORT=9001
