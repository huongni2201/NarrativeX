<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.narrativex.backend.feature.project.infrastructure.persistence.mybatis.ProjectQueryMapper">
    <resultMap id="projectAssetRow" type="com.narrativex.backend.feature.project.infrastructure.persistence.mybatis.ProjectAssetRow">
        <id property="id" column="id" />
        <result property="name" column="name" />
        <result property="assetType" column="asset_type" />
        <result property="storageKey" column="storage_key" />
        <result property="url" column="url" />
        <result property="mimeType" column="mime_type" />
        <result property="status" column="status" />
        <result property="metadataJson" column="metadata_json" />
        <result property="updatedAt" column="updated_at" />
    </resultMap>

    <sql id="assetColumns">
        id, name, asset_type, storage_key, url, mime_type, status,
        metadata_json::text AS metadata_json, updated_at
    </sql>

    <select id="findActiveAssetsFirstPage" resultMap="projectAssetRow">
        SELECT <include refid="assetColumns" />
          FROM project_assets
         WHERE project_id = #{projectId}
           AND status = 'ACTIVE'
         ORDER BY updated_at DESC, id DESC
         LIMIT #{limit}
    </select>

    <select id="findActiveAssetsAfter" resultMap="projectAssetRow">
        SELECT <include refid="assetColumns" />
          FROM project_assets
         WHERE project_id = #{projectId}
           AND status = 'ACTIVE'
           AND (updated_at &lt; #{updatedAt}
                OR (updated_at = #{updatedAt} AND id &lt; #{id}))
         ORDER BY updated_at DESC, id DESC
         LIMIT #{limit}
    </select>
</mapper>
