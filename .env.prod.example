# NarrativeX production environment template. Copy to .env.prod and fill all secrets.

COMPOSE_PROJECT_NAME=narrativex-prod
APP_DOMAIN=example.com
ACME_EMAIL=admin@example.com

DB_NAME=narrativex
DB_USERNAME=narrativex
DB_PASSWORD=replace-with-strong-password

NARRATIVEX_SESSION_TIMEOUT=7d
NARRATIVEX_SESSION_REDIS_NAMESPACE=narrativex:session
NARRATIVEX_OIDC_ENABLED=true
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
NARRATIVEX_MAX_STORY_CHARACTERS=500000
NARRATIVEX_MAX_ESTIMATED_INPUT_TOKENS=120000
NARRATIVEX_MAX_IMPORT_FILE_SIZE=10MB
NARRATIVEX_MAX_IMPORT_REQUEST_SIZE=11MB
NARRATIVEX_STORAGE_UPLOAD_INTENT_TTL=15m

WORKER_LOG_LEVEL=INFO
WORKER_POLL_INTERVAL_SECONDS=1
WORKER_LEASE_SECONDS=60
GENERAL_WORKER_CONCURRENCY=4
NARRATION_WORKER_CONCURRENCY=1
RENDER_WORKER_CONCURRENCY=1
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=120
MEDIA_PROBE_TIMEOUT_SECONDS=30
MEDIA_MAX_AUDIO_BYTES=104857600
MEDIA_MAX_IMAGE_BYTES=104857600
MEDIA_MAX_VIDEO_BYTES=1073741824

GOOGLE_CLOUD_PROJECT=
GCP_SERVICE_ACCOUNT_FILE=/absolute/path/to/gcp-service-account.json
VERTEX_LOCATION=us-central1
VERTEX_GEMINI_MODEL=gemini-2.5-flash
VERTEX_TIMEOUT_SECONDS=120

VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
VERTEX_IMAGE_LOCATION=global
VERTEX_IMAGE_TIMEOUT_SECONDS=120
VERTEX_IMAGE_BATCH_MAX_ITEMS=50
VERTEX_IMAGE_BATCH_LOCATION=global
VERTEX_IMAGE_BATCH_GCS_BUCKET=
VERTEX_IMAGE_BATCH_GCS_PREFIX=narrativex/image-batches
VERTEX_IMAGE_BATCH_POLL_SECONDS=30
VERTEX_IMAGE_BATCH_HTTP_TIMEOUT_SECONDS=120
VERTEX_IMAGE_UNKNOWN_MAX_AGE_SECONDS=3600
IMAGE_MAX_OUTPUT_BYTES=15000000

NARRATION_MP3_BITRATE=96k
VIENEU_VOICE_ID=vieneu-ngoc-huyen-v2
VIENEU_VOICE_NAME=Ngọc Huyền v2
VIENEU_REFERENCE_AUDIO_FILE=/absolute/path/to/reference.wav
VIENEU_BACKEND=onnx
VIENEU_PRECISION=int8
VIENEU_THREADS=0
VIENEU_BATCH_MAX_SEGMENTS=8
VIENEU_MAX_BATCH_SIZE=32
VIENEU_INFERENCE_CONCURRENCY=1
VIENEU_DENOISE_REFERENCE=true
VIENEU_SAVE_VOICE_PROFILE=false
VIENEU_FORCE_REENROLL=false
VIENEU_APPLY_WATERMARK=false

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=narrativex-prod
R2_ENDPOINT=
