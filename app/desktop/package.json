{
  "name": "narrativex-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "NarrativeX desktop editor shell",
  "main": "./out/main/main.js",
  "author": "NarrativeX",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "type-check": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "check": "npm test && npm run type-check && npm run build",
    "test": "node --experimental-strip-types --test test/*.test.mjs",
    "package:win": "npm run check && npx --yes electron-builder@26.15.7 --win nsis"
  },
  "dependencies": {
    "@narrativex/client-contracts": "file:../../packages/client-contracts",
    "@tanstack/react-query": "^5.101.4",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^37.2.6",
    "electron-vite": "^4.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.2",
    "sonner": "^2.0.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3"
  }
}
