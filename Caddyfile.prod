{
    auto_https off
}

:80 {
    @health path /healthz
    respond @health 200

    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }

    # This origin is reachable only through the cloudflared container on appnet.
    # Cloudflare terminates public TLS, so preserve the external HTTPS scheme for
    # Next.js, Spring Security, OAuth redirects, and secure session cookies.
    reverse_proxy frontend:3000 {
        flush_interval -1
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {http.request.host}
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
    }
}
