# NarrativeX Remote GPU Runtime Environment Template (RTX 3090)

# Networking & Security
NARRATIVEX_WORKER_PORT=8000
NARRATIVEX_WORKER_BEARER_TOKEN=replace-with-secure-bearer-token
NARRATIVEX_LOG_LEVEL=INFO

# Storage Mounts on Remote Host
MODELS_CACHE_DIR=/data/models
OUTPUTS_CACHE_DIR=/data/outputs
COMFYUI_WORKFLOWS_DIR=./workflows

# Single-GPU Residency Configuration (RTX 3090 24GB)
NARRATIVEX_RESIDENCY_TRANSITION_TIMEOUT=30
NARRATIVEX_RESIDENCY_MAX_VRAM_IDLE_MB=1500
