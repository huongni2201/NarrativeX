{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/compute/v1/produced-artifact.json",
  "title": "ProducedArtifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifactId",
    "role",
    "mediaType",
    "sizeBytes",
    "sha256"
  ],
  "properties": {
    "artifactId": {
      "type": "string",
      "format": "uuid"
    },
    "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "mediaType": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "sizeBytes": {
      "type": "integer",
      "minimum": 0
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "technicalMetadata": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "durationMs",
        "width",
        "height",
        "fps",
        "hasAudio",
        "decodePassed"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "hasAudio": {
          "type": "boolean"
        },
        "decodePassed": {
          "type": "boolean"
        },
        "qualityMetrics": {
          "description": "Advisory raw measurements. Thresholds and verdicts are owned by the backend.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "status",
            "scorerVersion"
          ],
          "properties": {
            "status": {
              "enum": [
                "MEASURED",
                "UNAVAILABLE"
              ]
            },
            "scorerVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 256
            },
            "freezeHeadMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "freezeTotalMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "motionMean": {
              "type": [
                "number",
                "null"
              ]
            },
            "sceneCutCount": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "flickerStddev": {
              "type": [
                "number",
                "null"
              ]
            },
            "blackTotalMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "silenceTotalMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "integratedLufs": {
              "type": [
                "number",
                "null"
              ]
            },
            "peakDbfs": {
              "type": [
                "number",
                "null"
              ]
            },
            "meanY": {
              "type": [
                "number",
                "null"
              ]
            },
            "meanU": {
              "type": [
                "number",
                "null"
              ]
            },
            "meanV": {
              "type": [
                "number",
                "null"
              ]
            }
          }
        }
      }
    }
  }
}
