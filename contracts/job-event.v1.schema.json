{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://narrativex.local/contracts/job-event.v1.schema.json",
  "title": "NarrativeX Job Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "idempotencyKey", "jobId", "operationId", "type", "status", "resourceClass"],
  "properties": {
    "schemaVersion": { "const": "job-event.v1" },
    "eventId": { "type": "string", "minLength": 1 },
    "idempotencyKey": { "type": "string", "minLength": 1 },
    "jobId": { "type": "string", "minLength": 1 },
    "operationId": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["CHAPTER_ANALYZE", "NARRATION_GENERATE", "CHAPTER_GENERATE", "RENDER_PROJECT"]
    },
    "status": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "STALLED", "UNKNOWN", "COMPLETED", "FAILED", "CANCELED"]
    },
    "resourceClass": {
      "type": "string",
      "enum": ["PROVIDER_INTERACTIVE", "PROVIDER_BATCH", "GPU_HEAVY", "CPU_RENDER", "CPU_LIGHT", "BACKGROUND", "NOTIFICATION", "FAST_CPU", "CPU_HEAVY", "MEDIA_IO"]
    },
    "stageId": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "providerOperationId": { "type": ["string", "null"] },
    "payload": { "type": "object" },
    "errorCode": { "type": ["string", "null"] }
  }
}
