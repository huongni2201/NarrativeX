#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/verify-local.ps1
fi

if command -v powershell >/dev/null 2>&1; then
  exec powershell -NoProfile -ExecutionPolicy Bypass -File scripts/verify-local.ps1
fi

echo "NarrativeX local verification requires pwsh or Windows PowerShell." >&2
exit 1
